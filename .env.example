INSTANTLY_API_KEY=
MONDAY_API_KEY=
MONDAY_WORKSPACE_ID=replace-with-workspace-id
# Optional explicit pins. When omitted, LINK OS requires one unambiguous
# canonical monday_mappings board ID for each destination.
MONDAY_INVENTORY_BOARD_ID=
MONDAY_ENTITIES_BOARD_ID=
MONDAY_REPLIES_BOARD_ID=
MONDAY_SYNC_LOG_BOARD_ID=
APIFY_API_TOKEN=
SE_RANKING_API_KEY=
SE_RANKING_API_BASE_URL=https://api.seranking.com
SE_RANKING_MONTHLY_CREDIT_CAP=10000
SE_RANKING_CACHE_DAYS=30
SEMRUSH_API_KEY=
AHREFS_API_KEY=
POSTGRES_DB=link_os
POSTGRES_USER=link_os
POSTGRES_PASSWORD=replace-with-a-local-password
LINK_OS_DB_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql+psycopg://link_os:replace-with-a-local-password@postgres:5432/link_os
LINK_OS_MODE=shadow
LINK_OS_API_AUTH_REQUIRED=true
LINK_OS_USE_POSTGRES_AUTH=true
LINK_OS_CLI_TOKEN=replace-with-a-random-local-token
LINK_OS_DATA_DIR=/app/deal-tracker/data/platform
# The authoritative outreach pause is stored in PostgreSQL. New databases
# initialise fail-closed; use the CLI/UI pause and resume controls.
SCRAPE_WORKERS=8
SCRAPE_HOST_DELAY_SECONDS=1
SCRAPE_MAX_PAGES_PER_DOMAIN=20
SCRAPE_TIMEOUT_SECONDS=10
SCRAPE_MAX_ATTEMPTS=3
CAMPAIGN_BATCH_SIZE=250
CAMPAIGN_PILOT_SIZE=25
SENDER_DAILY_NEW_LEADS_PILOT=10
SENDER_DAILY_EMAIL_LIMIT=30
SENDER_DAILY_NEW_LEADS_HEALTHY=15
REPLY_POLL_SECONDS=600
ANALYTICS_POLL_SECONDS=900
APP_SECRET_KEY=change-this-to-a-long-random-string
APP_BOOTSTRAP_ADMIN_EMAIL=admin@link-os.local
APP_BOOTSTRAP_ADMIN_PASSWORD=change-me-now
SYNC_INTERVAL_DAYS=3
